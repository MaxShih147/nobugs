# Notion Integration
# 1. Go to https://www.notion.so/my-integrations
# 2. Create a new integration
# 3. Copy the "Internal Integration Secret" here
NOTION_API_KEY=your_notion_api_key_here

# 4. Open your bugs database in Notion
# 5. Copy the database ID from the URL:
#    https://www.notion.so/{workspace}/{database_id}?v=...
NOTION_DATABASE_ID=your_database_id_here

# Server
PORT=3001
NODE_ENV=development

# Data source: "notion" or "mock"
# Use "mock" to develop without Notion connection
DATA_SOURCE=mock

# Authentication (optional)
# If INVITE_CODE and JWT_SECRET are set, the app requires login.
# If either is missing, the app runs without authentication (open access).

# Shared invite code — give this to your team members
INVITE_CODE=your_invite_code

# Secret for signing JWT session tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret

# Email allowlist (comma-separated)
# Only these emails can log in. Leave empty to allow anyone with the invite code.
ALLOWED_EMAILS=alice@example.com,bob@example.com
